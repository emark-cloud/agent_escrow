{
  "name": "agentescrow-bridge",
  "version": "1.0.0",
  "description": "AgentEscrow cross-chain bridge infrastructure",
  "scripts": {
    "compile": "npx hardhat compile",
    "deploy:base": "npx hardhat run deploy/deploy-base.ts --network baseSepolia",
    "deploy:zksync": "npx hardhat run deploy/deploy-zksync.ts --network zkSyncSepolia",
    "configure": "npx hardhat run deploy/configure-trust.ts",
